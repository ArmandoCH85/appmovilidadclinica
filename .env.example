# Copiar a `.env` y completar. NO versionar `.env`.
#
# Uso local:
#   cd backend
#   cp ../.env.example ../.env     # editar valores
#   set -a; source ../.env; set +a # exportar al shell
#   go run ./cmd/server
#
# En produccion se cargan por systemd (EnvironmentFile), ver DEPLOY.md.

# --- Backend (Go) ---
HTTP_PORT=8080
# Directorio de las migraciones *.up.sql (relativo al cwd del binario).
MIGRATIONS_DIR=./migrations
# Secreto HS256 del JWT. Generar uno largo y aleatorio:
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- Base de datos MariaDB / MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=cambiar
DB_NAME=transporte_corporativo_mvp
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
