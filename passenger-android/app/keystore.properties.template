# ============================================
# Plantilla de configuracion de firma release.
# Copiar como: app/keystore.properties
# Llenar con los valores reales.
# NO COMMITEAR (ya esta en .gitignore).
# ============================================

# Ruta al archivo de la keystore (relativa a passenger-android/)
# Recomendado: app/upload-keystore.jks
storeFile=app/upload-keystore.jks

# Alias de la clave dentro de la keystore
keyAlias=upload

# Password del keystore y de la clave (si son iguales, repetir)
storePassword=TU_PASSWORD_AQUI
keyPassword=TU_PASSWORD_AQUI
